{
  "api_keys": {
    "openai": ""
  },
  "models": {
    "local": {
      "disable": false,
      "api_url": "http://100.64.0.13:11438",
      "default_model": "qwen3.6:27b"
    },
    "local2": {
      "disable": true,
      "api_url": "http://127.0.0.1:11434",
      "default_model": "qwen3.5:2b"
    }
  },
  "logging": {
    "log_dir": "logs",
    "enable_console": true
  },
  "test_cases": {
    "basic_tests": [
      {
        "test_case": "简单问候",
        "prompt": "你好，请简单介绍一下自己。",
        "params": {
          "temperature": 0.7,
          "max_tokens": 200
        }
      },
      {
        "test_case": "数学计算",
        "prompt": "请计算 123456789 * 987654321 的结果。",
        "params": {
          "temperature": 0.1,
          "max_tokens": 500
        }
      },
      {
        "test_case": "代码生成",
        "prompt": "请用 Python 写一个快速排序算法。",
        "params": {
          "temperature": 0.3,
          "max_tokens": 1000
        }
      },
      {
        "test_case": "创意写作",
        "prompt": "请写一首关于春天的短诗。",
        "params": {
          "temperature": 0.9,
          "max_tokens": 500
        }
      },
      {
        "test_case": "翻译测试",
        "prompt": "请将以下句子翻译成中文: 'The quick brown fox jumps over the lazy dog.'",
        "params": {
          "temperature": 0.3,
          "max_tokens": 200
        }
      }
    ]
  }
}
